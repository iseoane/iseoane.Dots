{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "gentle-orchestrator": {
      "model": "openai/gpt-5.6-luna",
      "variant": "max"
    },
    "jd-fix-agent": {
      "model": "openai/gpt-5.6-luna",
      "variant": "max"
    },
    "jd-judge-a": {
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh"
    },
    "jd-judge-b": {
      "model": "openai/gpt-5.6-luna",
      "variant": "max"
    },
    "review-readability": {},
    "review-refuter": {},
    "review-reliability": {},
    "review-resilience": {},
    "review-risk": {},
    "review-validator": {}
  },
  "default_agent": "gentle-orchestrator",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "engram": {
        "type": "local",
        "command": [
          "engram",
          "mcp",
          "--tools=agent"
        ]
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "codemode": false
      }
    }
  },
  "plugin": [
    "@slkiser/opencode-quota@latest"
  ],
  "provider": {
    "openai": {},
    "opencode-go": {}
  },
  "share": "disabled"
}
