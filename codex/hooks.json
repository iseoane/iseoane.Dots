{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/home/iseoane/.engram-sync/sync.sh pull",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/home/iseoane/.engram-sync/sync.sh push",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ]
  }
}
