.atl/
.codegraph/
*.bak-*

# Never version SSH private keys or host fingerprints, even accidentally.
*.pem
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts*

# nvim/ is synced from a whole-directory copy (see README), so guard against
# committing machine-local secrets: the common LazyVim convention for a
# per-machine override (API keys for avante/copilot/gemini, etc.) is a
# local.lua/secrets.lua file or a .env, none of which should ever be shared.
nvim/**/local.lua
nvim/**/*.local.lua
nvim/**/secrets.lua
nvim/.env

# nvim spell files are large, machine-generated dictionaries (~26M) restored
# from the timestamped backup on deploy (see apply-to-system.sh); never version
# them. They were committed by accident once and untracked afterwards.
nvim/spell/

# Pi: only the curated declarative files under pi/ belong in Git. These names
# are credentials, generated state, histories, native dependencies or caches.
pi/auth.json
pi/mcp-cache.json
pi/models-store.json
pi/sessions/
pi/pi-pretty/
pi/calm
pi/npm/node_modules/

# OpenCode auth, databases, sessions/history and generated dependencies live
# outside the managed allowlist and must never enter this repository.
opencode/auth.json
opencode/opencode.db*
opencode/log/
opencode/tool-output/
opencode/prompt-history.jsonl
opencode/model.json
opencode/node_modules/
